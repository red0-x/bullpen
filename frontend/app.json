{
  "expo": {
    "name": "Bullpen",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.bullpenmirror.q3lzrl",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap what broke so Bullpen finds who fixes it",
        "NSPhotoLibraryUsageDescription": "Pick a photo of what broke at your rental",
        "NSMicrophoneUsageDescription": "Record room walkthrough videos with sound"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBF4EA"
      },
      "package": "com.emergent.bullpenmirror.q3lzrl",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF4EA"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/lucide",
      [
        "expo-camera",
        {
          "cameraPermission": "Photograph rooms to tag appliances",
          "recordAudioAndroid": false
        }
      ],
      "expo-roomplan",
      [
        "munim-xr",
        {
          "cameraPermission": "Scan rooms and tag appliances in AR",
          "arRequired": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
